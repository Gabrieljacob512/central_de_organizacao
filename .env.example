# ==============================================================================
# TECNO SYSTEM SERVICE DESK - VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha com as credenciais do seu ambiente.
# NUNCA commite o arquivo .env no Git.
# ==============================================================================

# Supabase (Local ou Cloud)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Chave administrativa (Service Role) - Usada apenas em scripts/seed-dev.ts e Edge Functions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Credenciais de Seed (Desenvolvimento)
SEED_PRESIDENT_PASSWORD=SenhaSegura@123
# Senha única de todos os usuários de demonstração (usada por npm run dev:reset-users)
# Mínimo 8 caracteres, com letras e números.
SEED_DEFAULT_PASSWORD=TroqueEstaSenha@123

# Integrações Opcionais
RESEND_API_KEY=
DISCORD_WEBHOOK_URL=
